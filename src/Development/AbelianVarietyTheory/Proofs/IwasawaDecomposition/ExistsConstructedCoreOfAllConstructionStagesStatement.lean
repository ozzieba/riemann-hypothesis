  obtain ⟨hJ, ha, h1, h2, h3, h4⟩ := h
  have e : cT (σ : E →+* E) (consCol x B) * J * consCol x B = blk (algebraMap F E a) J' := by
    ext i j
    rw [gram_apply]
    cases i using Fin.cases <;> cases j using Fin.cases
    · exact h1
    · exact h2 _
    · rename_i i
